{
  "compilerOptions": {
    "target": "ES2021",
    "module": "commonjs",
    "moduleDetection": "force",
    "lib": ["ES2021"],
    "types": ["node"],
    "outDir": "../dist-electron",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "declaration": false,
    "sourceMap": true
  },
  "include": ["./**/*.ts"]
}
