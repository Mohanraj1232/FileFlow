{
  "$schema": "https://raw.githubusercontent.com/nicedayto/tauri-schema/master/tauri.conf.json",
  "productName": "FileFlow",
  "version": "0.1.0",
  "identifier": "com.fileflow.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "title": "FileFlow",
    "windows": [
      {
        "title": "FileFlow — Your files. Automatically organized.",
        "width": 1100,
        "height": 700,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "dialog": {},
    "notification": {},
    "fs": {
      "scope": ["**"]
    },
    "shell": {
      "open": true
    }
  }
}
